#!/bin/sh
# Second line of defence: scan every commit about to leave this PC; refuse the push on any finding.
# Installed by agentos/tools/install-secret-hooks.ps1. Fails CLOSED if gitleaks is missing. Never bypass this (no --no-verify).
GL="$(command -v gitleaks 2>/dev/null)"
[ -z "$GL" ] && [ -x "$LOCALAPPDATA/Microsoft/WinGet/Links/gitleaks.exe" ] && GL="$LOCALAPPDATA/Microsoft/WinGet/Links/gitleaks.exe"
[ -z "$GL" ] && GL="$(ls "$LOCALAPPDATA"/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_*/gitleaks.exe 2>/dev/null | head -n 1)"
if [ -z "$GL" ]; then
  echo "BLOCKED: gitleaks not found, so the secret check cannot run. Push refused (fail closed)." >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                 # deleting a branch: nothing goes out
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"  # new branch: scan its whole history
  else range="$remote_sha..$local_sha"; fi
  if ! "$GL" git --log-opts="$range" --redact --no-banner --exit-code 1 .; then
    echo "BLOCKED: gitleaks found what looks like a secret in commits being pushed ($range)." >&2
    status=1
  fi
done
if [ "$status" -ne 0 ]; then
  echo "Push refused. If a real key reached a commit: tell the operator, REVOKE the key at the provider first, then clean the history." >&2
fi
exit $status
